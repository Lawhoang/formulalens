<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="TaskPaneApp">
  <Id>7c1e5a52-3b0f-4d0e-9d57-2f4b8a6e1c90</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>FormulaLens</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="FormulaLens"/>
  <Description DefaultValue="Explore formula logic, map formulas, compare sheets."/>
  <IconUrl DefaultValue="https://localhost:3000/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:3000/icon-80.png"/>
  <SupportUrl DefaultValue="https://localhost:3000/taskpane.html"/>
  <AppDomains><AppDomain>https://localhost:3000</AppDomain></AppDomains>
  <Hosts><Host Name="Workbook"/></Hosts>
  <Requirements><Sets><Set Name="ExcelApi" MinVersion="1.12"/></Sets></Requirements>
  <DefaultSettings><SourceLocation DefaultValue="https://localhost:3000/taskpane.html"/></DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements><bt:Sets DefaultMinVersion="1.1"><bt:Set Name="SharedRuntime"/></bt:Sets></Requirements>
    <Hosts>
      <Host xsi:type="Workbook">
        <Runtimes><Runtime resid="Taskpane.Url" lifetime="long"/></Runtimes>
        <DesktopFormFactor>
          <FunctionFile resid="Taskpane.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <CustomTab id="FormulaLens.Tab">
              <Group id="FL.Explorer">
                <Label resid="G.Explorer"/>
                <Icon><bt:Image size="16" resid="Icon16"/><bt:Image size="32" resid="Icon32"/><bt:Image size="80" resid="Icon80"/></Icon>
                <Control xsi:type="Button" id="FL.Prec">
                  <Label resid="L.Prec"/>
                  <Supertip><Title resid="L.Prec"/><Description resid="D.Prec"/></Supertip>
                  <Icon><bt:Image size="16" resid="Icon16"/><bt:Image size="32" resid="Icon32"/><bt:Image size="80" resid="Icon80"/></Icon>
                  <Action xsi:type="ExecuteFunction"><FunctionName>explorePrecedents</FunctionName></Action>
                </Control>
                <Control xsi:type="Button" id="FL.Dep">
                  <Label resid="L.Dep"/>
                  <Supertip><Title resid="L.Dep"/><Description resid="D.Dep"/></Supertip>
                  <Icon><bt:Image size="16" resid="Icon16"/><bt:Image size="32" resid="Icon32"/><bt:Image size="80" resid="Icon80"/></Icon>
                  <Action xsi:type="ExecuteFunction"><FunctionName>exploreDependents</FunctionName></Action>
                </Control>
              </Group>
              <Group id="FL.Map">
                <Label resid="G.Map"/>
                <Icon><bt:Image size="16" resid="Icon16"/><bt:Image size="32" resid="Icon32"/><bt:Image size="80" resid="Icon80"/></Icon>
                <Control xsi:type="Button" id="FL.Map1">
                  <Label resid="L.Map"/>
                  <Supertip><Title resid="L.Map"/><Description resid="D.Map"/></Supertip>
                  <Icon><bt:Image size="16" resid="Icon16"/><bt:Image size="32" resid="Icon32"/><bt:Image size="80" resid="Icon80"/></Icon>
                  <Action xsi:type="ExecuteFunction"><FunctionName>formulaMap</FunctionName></Action>
                </Control>
                <Control xsi:type="Button" id="FL.Clear">
                  <Label resid="L.Clear"/>
                  <Supertip><Title resid="L.Clear"/><Description resid="D.Clear"/></Supertip>
                  <Icon><bt:Image size="16" resid="Icon16"/><bt:Image size="32" resid="Icon32"/><bt:Image size="80" resid="Icon80"/></Icon>
                  <Action xsi:type="ExecuteFunction"><FunctionName>clearMap</FunctionName></Action>
                </Control>
              </Group>
              <Group id="FL.Pane">
                <Label resid="G.Pane"/>
                <Icon><bt:Image size="16" resid="Icon16"/><bt:Image size="32" resid="Icon32"/><bt:Image size="80" resid="Icon80"/></Icon>
                <Control xsi:type="Button" id="FL.Open">
                  <Label resid="L.Open"/>
                  <Supertip><Title resid="L.Open"/><Description resid="D.Open"/></Supertip>
                  <Icon><bt:Image size="16" resid="Icon16"/><bt:Image size="32" resid="Icon32"/><bt:Image size="80" resid="Icon80"/></Icon>
                  <Action xsi:type="ExecuteFunction"><FunctionName>openPane</FunctionName></Action>
                </Control>
              </Group>
              <Label resid="Tab.Label"/>
            </CustomTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon16" DefaultValue="https://localhost:3000/icon-16.png"/>
        <bt:Image id="Icon32" DefaultValue="https://localhost:3000/icon-32.png"/>
        <bt:Image id="Icon80" DefaultValue="https://localhost:3000/icon-80.png"/>
      </bt:Images>
      <bt:Urls><bt:Url id="Taskpane.Url" DefaultValue="https://localhost:3000/taskpane.html"/></bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Tab.Label" DefaultValue="FormulaLens"/>
        <bt:String id="G.Explorer" DefaultValue="Formula explorer"/>
        <bt:String id="G.Map" DefaultValue="Formula map"/>
        <bt:String id="G.Pane" DefaultValue="Panel"/>
        <bt:String id="L.Prec" DefaultValue="Explore precedents"/>
        <bt:String id="L.Dep" DefaultValue="Explore dependents"/>
        <bt:String id="L.Map" DefaultValue="Map formulas"/>
        <bt:String id="L.Clear" DefaultValue="Clear colours"/>
        <bt:String id="L.Open" DefaultValue="Open panel"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="D.Prec" DefaultValue="Show the logic of the selected formula and the cells it uses (Ctrl+Shift+Q)."/>
        <bt:String id="D.Dep" DefaultValue="List the cells that depend on the selection (Ctrl+Q)."/>
        <bt:String id="D.Map" DefaultValue="Colour the sheet to reveal hard-codes, external links and inconsistent formulas."/>
        <bt:String id="D.Clear" DefaultValue="Remove temporary colours and restore the original fills."/>
        <bt:String id="D.Open" DefaultValue="Open the FormulaLens panel."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
  <ExtendedOverrides Url="https://localhost:3000/shortcuts.json"></ExtendedOverrides>
</OfficeApp>
